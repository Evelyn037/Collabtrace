GITHUB_TOKEN=
# Local default. Production may override this with a secret Neon PostgreSQL URL.
DATABASE_URL=sqlite:///./data/collabtrace.db
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
VERIFICATION_CODE_SECRET=
VERIFICATION_PROVIDER=console
# Optional legacy verification subsystem; not used by current registration or login.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true
QUICK_ANALYZE_MAX_PAGES=1
QUICK_ANALYZE_MAX_PRS_FOR_REVIEWS=5
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
